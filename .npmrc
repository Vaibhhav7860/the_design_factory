# next-auth@5.0.0-beta.25 declares peerDependencies of next "^14 || ^15".
# We're on Next 16. The library actually works on Next 16 — Auth.js just
# hasn't bumped the peer range yet (tracked at
# https://github.com/nextauthjs/next-auth/issues/13302).
# legacy-peer-deps lets npm install while ignoring this single mismatch,
# matching the behaviour of npm <= 6 and what Vercel's build system needs.
legacy-peer-deps=true
